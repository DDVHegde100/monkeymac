# MongoDB Connection String
# Local: mongodb://localhost:27017/monkeymax
# Atlas: mongodb+srv://username:password@cluster.mongodb.net/monkeymax
MONGODB_URI=mongodb://localhost:27017/monkeymax

# JWT Secret for authentication (required in production)
# Generate with: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Next.js Environment
NODE_ENV=development

# --- Vercel deploy checklist ---
# 1. Set MONGODB_URI and JWT_SECRET in Vercel project Environment Variables
# 2. Use a strong, unique JWT_SECRET (never commit real secrets)
# 3. MongoDB Atlas: allow network access from 0.0.0.0/0 or Vercel IP ranges
# 4. Run `npm run build` locally before pushing to catch build errors early
