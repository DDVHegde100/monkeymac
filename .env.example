# MongoDB Connection String
# For local development: mongodb://localhost:27017/monkeymax
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/monkeymax
MONGODB_URI=mongodb://localhost:27017/monkeymax

# JWT Secret for authentication
# Generate a secure random string for production
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# SMS Services (Optional - for phone verification)
# Twilio (Recommended - most reliable)
# Get free account at https://twilio.com
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# SMS.to (Alternative free option)
# Get free API key at https://sms.to
SMS_TO_API_KEY=your_sms_to_api_key

# Next.js Environment
NODE_ENV=development
